{
  "name": "clean-air-compass",
  "version": "1.0.0",
  "description": "GenAI-powered assistant that helps families and communities navigate winter smog with low-emission routines, indoor air hacks and sustainable swaps, with the impact of every choice explained.",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "check": "node scripts/check.js",
    "diagnose": "node scripts/diagnose.js",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "air-quality",
    "smog",
    "genai",
    "gemini",
    "sustainability",
    "accessibility"
  ],
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0"
  }
}
