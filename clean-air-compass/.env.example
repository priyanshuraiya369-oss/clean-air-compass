# Strongly recommended: with a key, Gemini writes the whole personalised plan.
# Without a key the app still works using its built-in rules engine.
# Get a key at https://aistudio.google.com/apikey  (never commit your real key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Used automatically if the model above is unavailable for your key (comma separated).
GEMINI_FALLBACK_MODELS=gemini-2.5-flash
PORT=8080
# Number of trusted reverse-proxy hops (Cloud Run = 1). Leave 0 when not behind a proxy.
TRUST_PROXY_HOPS=0

# Optional free fallback for live AQI (nearest monitoring station). Get a token at https://aqicn.org/data-platform/token/
WAQI_TOKEN=08501999011caabdd8829f396337ae8a41fdf432
